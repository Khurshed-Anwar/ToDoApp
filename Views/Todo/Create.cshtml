@model ToDoApp.Models.TodoItem

<h1>Create Task</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Task" class="form-label"></label>
                <input asp-for="Task" class="form-control" />
                <span asp-validation-for="Task" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DueDate" class="form-label"></label>
                <input asp-for="DueDate" class="form-control" />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Priority" class="form-label"></label>
                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<ToDoApp.Models.Priority>()" class="form-select"></select>
                <span asp-validation-for="Priority" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-co-primary">Save</button>
            <a asp-action="Index" class="btn btn-co-secondary">Back</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
